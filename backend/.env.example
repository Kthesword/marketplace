# Copy to backend/.env and adjust. Never commit the real .env.

# HTTP port the API listens on
PORT=8080

# Postgres connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgres://marketplace:marketplace@localhost:5433/marketplace?sslmode=disable

# Secret used to sign JWTs. Use a long random value, e.g.:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# How long a login token stays valid (Go duration syntax: 30m, 24h)
JWT_TTL=24h

# Apply pending SQL migrations when the API starts
MIGRATE_ON_START=true

